generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id          Int     @id @default(autoincrement())
  titulo      String  @db.Char(127)
  descripcion String  @db.Text
  precio      Decimal
  imagen      String  @db.Char(127)
}