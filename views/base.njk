<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <title>GeekBook Store</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>
<body>

<nav class="navbar navbar-dark bg-dark">
    <div class="container">

        <a
            href="/"
            class="navbar-brand"
        >
            GeekBook Store
        </a>

        <form
            class="d-flex"
            action="/buscar"
            method="GET"
        >

            <input
                class="form-control me-2"
                type="search"
                name="busqueda"
                placeholder="Buscar libros"
                value="{{ busqueda or '' }}"
            >

            <button
                class="btn btn-outline-light"
                type="submit"
            >
                Buscar
            </button>

        </form>

        <div class="d-flex align-items-center gap-3">

            <span class="text-white">

                🛒 {{ total_carrito }}

            </span>

            {% if usuario %}

            <span class="text-white">

                Hola {{ usuario }}

            </span>

            <a
                href="/logout"
                class="btn btn-outline-light"
            >
                Logout
            </a>

            {% else %}

            <a
                href="/login"
                class="btn btn-outline-light"
            >
                Login
            </a>

            {% endif %}

        </div>

    </div>
</nav>

<div class="container mt-4">

    {% block content %}
    {% endblock %}

</div>

</body>
</html>