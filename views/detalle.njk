{% extends "base.njk" %}

{% block content %}

<div class="card">

    <div class="row g-0">

        <div class="col-md-4">

            <img
                src="https://books.toscrape.com/{{ card.imagen }}"
                class="img-fluid"
            >

        </div>

        <div class="col-md-8">

            <div class="card-body">

                <h1>{{ card.titulo }}</h1>

                <p class="fs-4">
                    {{ card.precio }}
                </p>

                <p>
                    {{ card.descripcion }}
                </p>

                <form
    action="/al-carrito/{{ card.id }}"
    method="POST"
>

    <div class="mb-3">

        <label class="form-label">
            Cantidad
        </label>

        <input
            type="number"
            name="cantidad"
            value="1"
            min="1"
            class="form-control"
        >

    </div>

    <button
        class="btn btn-dark"
        type="submit"
    >
        Añadir al carrito
    </button>

</form>

            </div>

        </div>

    </div>

</div>

{% endblock %}